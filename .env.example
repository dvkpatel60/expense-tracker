# Copy to .env and fill in whichever providers you want available.
#
#   cp .env.example .env
#
# .env is gitignored. Nothing in here is read by the browser bundle — the keys
# are used only by the serverless functions (and by the local dev API server),
# so they never reach the client.
#
# You need at least one. Leave the others blank and they simply won't be offered
# in the app's provider picker; every local categorization rule still runs.

# Anthropic — https://console.anthropic.com/settings/keys
# Models offered: Haiku 4.5, Sonnet 5, Opus 5
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Models offered: 2.5 Flash, 2.5 Flash-Lite, 2.0 Flash, 2.0 Flash-Lite (free tier)
GEMINI_API_KEY=
